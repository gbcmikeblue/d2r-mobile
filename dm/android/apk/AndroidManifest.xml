<?xml version="1.0" encoding="utf-8"?>
<!--
  安卓窗口最小工程的清单（M3 的第一块，见 docs/ANDROID_PLAN 的 M3 一节）。
  为什么只有一个 NativeActivity、没有一行 Java：宿主就是纯 C，机器码进 lib/arm64-v8a/，由 NativeActivity 装载并
  调 android_main；`hasCode="false"` 明确告诉系统这个包里没有 dex —— 于是不需要 javac/d8，也就绕开了本机没有
  Android Studio 构建链这件事（aapt2 + zip + zipalign + apksigner 就够了）。
  The manifest of the minimal Android window project (the first piece of M3; see the M3 section of
  docs/ANDROID_PLAN). Why a single NativeActivity and no Java at all: the host is plain C, the machine code goes into
  lib/arm64-v8a/ and NativeActivity loads it and calls android_main; `hasCode="false"` tells the system there is no dex
  in the package, which removes the need for javac/d8 and with it the absence of an Android Studio build chain on this
  machine (aapt2 + zip + zipalign + apksigner is enough).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="ai.d2rm.dm"
          android:versionCode="1"
          android:versionName="0.1">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36" />

    <!-- Vulkan 1.3 是硬要求（设备实测 1.3.284）。| Vulkan 1.3 is a hard requirement (the device reports 1.3.284). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00400003" android:required="true" />

    <!-- 外部存储读：这一版还不用（数据先不搬），但 M3 之后要从 /sdcard 读游戏数据，先声明不申请权限。
         External storage read: not used by this version yet (the data is not moved over yet), but M3 and later read the
         game data from /sdcard, so it is declared without being requested. -->

    <application android:label="D2R 移植（测试窗口）"
                 android:hasCode="false"
                 android:debuggable="true"
                 android:allowBackup="false">

        <activity android:name="android.app.NativeActivity"
                  android:label="D2R 移植（测试窗口）"
                  android:exported="true"
                  android:launchMode="singleTask"
                  android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density"
                  android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

            <!-- 这是"装载哪个 .so"的约定：lib/arm64-v8a/libdm.so，入口 ANativeActivity_onCreate（app_glue 提供）。
                 This is the "which .so to load" convention: lib/arm64-v8a/libdm.so, entry ANativeActivity_onCreate
                 (provided by app_glue). -->
            <meta-data android:name="android.app.lib_name" android:value="dm" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
