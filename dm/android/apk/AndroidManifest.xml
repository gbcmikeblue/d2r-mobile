<?xml version="1.0" encoding="utf-8"?>
<!--
  安卓窗口最小工程的清单（M3 的第一块，见 docs/ANDROID_PLAN 的 M3 一节）。
  为什么只有一个 NativeActivity、没有一行 Java：宿主就是纯 C，机器码进 lib/arm64-v8a/，由 NativeActivity 装载并
  调 android_main；`hasCode="false"` 明确告诉系统这个包里没有 dex —— 于是不需要 javac/d8，也就绕开了本机没有
  Android Studio 构建链这件事（aapt2 + zip + zipalign + apksigner 就够了）。
  The manifest of the minimal Android window project (the first piece of M3; see the M3 section of
  docs/ANDROID_PLAN). Why a single NativeActivity and no Java at all: the host is plain C, the machine code goes into
  lib/arm64-v8a/ and NativeActivity loads it and calls android_main; `hasCode="false"` tells the system there is no dex
  in the package, which removes the need for javac/d8 and with it the absence of an Android Studio build chain on this
  machine (aapt2 + zip + zipalign + apksigner is enough).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="ai.d2rm.dm"
          android:versionCode="1"
          android:versionName="0.1">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36" />

    <!-- Vulkan 1.3 是硬要求（设备实测 1.3.284）。| Vulkan 1.3 is a hard requirement (the device reports 1.3.284). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00400003" android:required="true" />

    <!-- 触摸屏：这是个游戏，没有触摸就没法玩。| Touchscreen: this is a game and is unplayable without one. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <!-- 权限集**故意只有两条**，其余一律不申请（少一条权限就少一份需要解释的东西）。 -->
    <!-- The permission set is **deliberately just two**; nothing else is requested (one fewer permission is one fewer
         thing needing an explanation). -->

    <!-- ① INTERNET：普通权限，装完即生效、不需要申请。游戏自己会联网（宿主日志里有 LibcurlResolver）。 -->
    <!-- (1) INTERNET: a normal permission, effective once installed and needing no request. The game goes online by
         itself (the host log shows LibcurlResolver). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ② MANAGE_EXTERNAL_STORAGE（"所有文件访问"）：**特殊权限**，必须由用户在系统设置里点开，所以窗口里放了一个按钮
         （见 main_apk.c；按钮的**有与无**本身就是权限状态，所以不必画字）。它买到的是「数据放在用户看得见、随时能用
         文件管理器替换的地方」（/sdcard/d2rm，正是入口里已经写好的那条备用路径）。它**不是** /data/local/tmp 的写权限：
         那里是 SELinux 的 shell_data_file，任何权限都到不了 —— 真机实测：授权后写入仍然 errno 13。 -->
    <!-- (2) MANAGE_EXTERNAL_STORAGE ("all files access"): a **special** permission the user has to switch on in system
         settings, which is why the window carries a button (see main_apk.c; the button's **presence or absence is itself
         the permission state**, so nothing needs drawing in words). What it buys is "data in a place the user can see and
         replace with a file manager at any time" (/sdcard/d2rm, the very fallback path the entry already knows). It is
         **not** write access to /data/local/tmp: that is SELinux's shell_data_file and no permission reaches it, measured
         on the device, where the write still fails with errno 13 even after the grant. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- 外部存储读：这一版还不用（数据先不搬），但 M3 之后要从 /sdcard 读游戏数据，先声明不申请权限。
         External storage read: not used by this version yet (the data is not moved over yet), but M3 and later read the
         game data from /sdcard, so it is declared without being requested. -->

    <application android:label="D2R 移植（测试窗口）"
                 android:hasCode="false"
                 android:debuggable="true"
                 android:allowBackup="false">

        <activity android:name="android.app.NativeActivity"
                  android:label="D2R 移植（测试窗口）"
                  android:exported="true"
                  android:launchMode="singleTask"
                  android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density"
                  android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

            <!-- 这是"装载哪个 .so"的约定：lib/arm64-v8a/libdm.so，入口 ANativeActivity_onCreate（app_glue 提供）。
                 This is the "which .so to load" convention: lib/arm64-v8a/libdm.so, entry ANativeActivity_onCreate
                 (provided by app_glue). -->
            <meta-data android:name="android.app.lib_name" android:value="dm" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
